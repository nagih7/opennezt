{
    "ext": "js, json, mjs, ts, jsx, tsx",
    "ignore": ["node_modules/", "dist/", "build/", "coverage/", "**/*.test.js", "**/*.spec.js", "**/*.test.ts", "**/*.spec.ts", "logs/", "temp/"],
    "watch": ["src/", ".env"],
    "execMap": {
        "js": "babel-node",
        "ts": "ts-node"
    },
    "env": {
        "DEBUG": "app:*"
    },
    "delay": 1000,
    "restartable": "rs",
    "verbose": false,
    "colours": true,
    "legacyWatch": false,
    "pollingInterval": 100,
    "runOnChangeOnly": false
}
