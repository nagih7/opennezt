# MongoDB Atlas Configuration
DB_PORT=27017
DB_HOST=your_cluster.mongodb.net
DB_USERNAME=your_atlas_username
DB_PASSWORD=your_atlas_password
DB_NAME=OpenNezt-V1
DB_AUTH_SOURCE=admin

# Application Configuration
NODE_ENV=production
APP_NAME=OpenNezt
APP_URL_API=http://localhost:3456
APP_URL_CLIENT=http://localhost:3000
APP_URL_AUTH=auth
SECRET_KEY=your_secure_secret_key_here
LOGIN_EXPIRE_IN=7d
VERIFY_EMAIL_EXPIRE_IN=10m
REQUESTS_LIMIT_PER_MINUTE=200

# Mail Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=no-reply@opennezt.com
MAIL_FROM_NAME=OpenNezt
MAIL_TO=admin@opennezt.com

# Push Notifications (Optional)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# External APIs (Optional)
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_SPEECH_URL=https://api.openai.com/v1/audio/speech
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
AI_API_URL=your_ai_api_url
AI_API_TOKEN=your_ai_api_token
